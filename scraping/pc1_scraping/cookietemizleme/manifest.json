{
  "manifest_version": 3,
  "name": "Site Cookie Temizleyici",
  "version": "1.0",
  "description": "Belirli sitelere girince otomatik cookie siler",
  
  "permissions": [
    "cookies",
    "tabs",
    "storage",
    "scripting",
    "browsingData",
    "downloads"
  ],
  
  "host_permissions": [
    "<all_urls>",
    "*://*.sahibinden.com/*",
    "*://sahibinden.com/*"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["*://*.sahibinden.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}