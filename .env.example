  # Sahibinden Car Scraper - Environment Variables

  # Database Configuration
  DATABASE_URL=postgresql://username:password@host:port/database
  DB_HOST=localhost
  DB_PORT=5432
  DB_NAME=sahibinden_cars
  DB_USER=postgres
  DB_PASSWORD=your_password

  # API Keys
  BRIGHT_DATA_API_KEY=your_bright_data_api_key_here
  BRIGHT_DATA_ZONE=web_unlocker1

  # SOAX Proxy Configuration
  SOAX_PROXY_USER=your_soax_username
  SOAX_PROXY_PASS=your_soax_password
  SOAX_PROXY_HOST=proxy.soax.com
  SOAX_PROXY_PORT=9000

  # Server Configuration
  PORT=3000
  NODE_ENV=development
